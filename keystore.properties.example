# Copy this file to keystore.properties and replace every placeholder locally.
# Never commit keystore.properties or the production keystore.
# The scripts/build-production-release.ps1 helper avoids this file entirely by
# passing the same values through temporary process environment variables.
storeFile=C:/secure/location/roomdeck-production.jks
storePassword=REPLACE_WITH_A_STRONG_PRIVATE_PASSWORD
keyAlias=roomdeck
keyPassword=REPLACE_WITH_A_STRONG_PRIVATE_PASSWORD
